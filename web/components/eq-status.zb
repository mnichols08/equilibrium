<!--
  Where you are and how you, the land and the world are doing.
  @prop {string} world - One line about the wider world: the land, its house, the era, the mood, your bloodline. Empty hides it.
  @prop {{ name: string, marked: boolean, asleep: boolean }[]} company - Everyone else standing where you are.
  @prop {{ place_name: string, description: string, health: number, life: number, ectoplasm: number, spirit_tier: string, body: null | { state: string }, forgotten: null | { unborn: boolean, dormant: boolean, memories: number, needed: number, time_left: number }, afterlife: null | { level: number, needed: number }, rested: number, taint: number, marked: boolean, skills: { name: string, level: number }[], attributes: { name: string, level: number }[], pack: { name: string, amount: number }[] }} you - Your character.
-->
<script>
  const emptyYou = { place_name: '', description: '', health: 100, life: 1, ectoplasm: 0, spirit_tier: 'Lost Shade', body: null, forgotten: null, afterlife: null, rested: 100, taint: 0, marked: false, skills: [], attributes: [], pack: [] }
  const trained = [...you.skills, ...you.attributes].filter((entry) => entry.level > 0)
  const carrying = you.pack.map((item) => `${item.amount} ${item.name}`).join(', ')
  const note = (person) => (person.asleep ? ' (asleep)' : person.marked ? ' (marked)' : '')
  const minutes = (seconds) => `${Math.ceil(seconds / 60)} min`
  const found = you.afterlife ? `Practised to level ${you.afterlife.level} of the ${you.afterlife.needed} that bring you back.` : ''
  const bodyLine = (body) =>
    body.state === 'buried'
      ? 'You are a spirit. Someone has buried the body you left: your next life will remember this one.'
      : 'You are a spirit. That life is over, and there is no going back to the body you left.'
  const forgottenLine = (forgotten) =>
    forgotten.unborn
      ? 'You have not lived yet. Practise where the living would work, and be born where the world needs people.'
      : `You are a forgotten spirit with no body. ${forgotten.memories} of ${forgotten.needed} memories found. ${forgotten.dormant ? 'You lie dormant.' : `You fade in ${minutes(forgotten.time_left)} awake.`}`
  const spirit = [you.body ? bodyLine(you.body) : you.forgotten ? forgottenLine(you.forgotten) : '', found].filter(Boolean).join(' ')
  const alsoHere = company.map((person) => `${person.name}${note(person)}`).join(', ')
</script>
<style>
  :host { display: block; }
  header { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
  h2 { margin: 0; font-size: 1.1rem; }
  p { margin: 0.35rem 0; }
  .meta { font-variant-numeric: tabular-nums; color: var(--eq-muted, #5b574e); }
  meter { width: 5rem; vertical-align: middle; }
  .marked { color: var(--eq-marked, #a3262a); font-weight: 600; }
  ul { margin: 0.35rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; }
</style>
<eq-status clock="0:00:00" tide="low" vitality={100} health="peak health" world="" you={emptyYou} company={[]}>
  <header>
    <h2>{you.place_name}</h2>
    <span class="meta">{clock} · {tide} tide</span>
  </header>
  <p zb-if={world} class="meta">{world}</p>
  <p>{you.description}</p>
  <p zb-if={alsoHere}>Also here: {alsoHere}.</p>
  <p zb-if={spirit} class="marked" role="status">{spirit}</p>
  <p>
    <label>This land <meter min="0" max="100" low="31" high="81" optimum="100" value={vitality}></meter> {vitality} ({health})</label>
  </p>
  <p>
    <label>Health <meter min="0" max="100" low="30" high="60" optimum="100" value={you.health}></meter> {you.health}{you.life > 1 ? ` · life ${you.life}` : ""}</label>
  </p>
  <p>
    <label>Rested <meter min="0" max="100" low="25" high="50" optimum="100" value={you.rested}></meter> {you.rested}</label>
  </p>
  <p zb-if={you.taint > 0} class:marked={you.marked}>
    Taint {you.taint}{you.marked ? " — the land has marked you" : ""}
  </p>
  <p>{carrying ? `You carry ${carrying}.` : "You carry nothing."}</p>
  <p zb-if={you.ectoplasm > 0}>Ectoplasm {you.ectoplasm} ({you.spirit_tier})</p>
  <ul zb-if={trained.length > 0} aria-label="Skills and attributes">
    <zb-each items={trained} as="entry" key={entry.name}>
      <li>{entry.name} {entry.level}</li>
    </zb-each>
  </ul>
</eq-status>
