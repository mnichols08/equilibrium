<!--
  Where you are and how you and the shoreline are doing.
  @prop {{ place_name: string, description: string, taint: number, marked: boolean, skills: { name: string, level: number }[], attributes: { name: string, level: number }[], pack: { name: string, amount: number }[] }} you - Your character.
-->
<script>
  const emptyYou = { place_name: '', description: '', taint: 0, marked: false, skills: [], attributes: [], pack: [] }
  const trained = [...you.skills, ...you.attributes].filter((entry) => entry.level > 0)
  const carrying = you.pack.map((item) => `${item.amount} ${item.name}`).join(', ')
</script>
<style>
  :host { display: block; }
  header { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
  h2 { margin: 0; font-size: 1.1rem; }
  p { margin: 0.35rem 0; }
  .meta { font-variant-numeric: tabular-nums; color: var(--eq-muted, #5b574e); }
  meter { width: 5rem; vertical-align: middle; }
  .marked { color: var(--eq-marked, #a3262a); font-weight: 600; }
  ul { margin: 0.35rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; }
</style>
<eq-status clock="0:00:00" tide="low" vitality={100} health="peak health" you={emptyYou}>
  <header>
    <h2>{you.place_name}</h2>
    <span class="meta">{clock} · {tide} tide</span>
  </header>
  <p>{you.description}</p>
  <p>
    <label>Shoreline <meter min="0" max="100" low="31" high="81" optimum="100" value={vitality}></meter> {vitality} ({health})</label>
  </p>
  <p zb-if={you.taint > 0} class:marked={you.marked}>
    Taint {you.taint}{you.marked ? " — the land has marked you" : ""}
  </p>
  <p>{carrying ? `You carry ${carrying}.` : "You carry nothing."}</p>
  <ul zb-if={trained.length > 0} aria-label="Skills and attributes">
    <zb-each items={trained} as="entry" key={entry.name}>
      <li>{entry.name} {entry.level}</li>
    </zb-each>
  </ul>
</eq-status>
