<!--
  What you can do right now: walk out by an exit, gather, pick things up, challenge someone, or let time pass.
  A spirit can only walk, return to its body, or give the body up.
  @prop {{ label: string, to: number, to_name: string, open: boolean }[]} exits - The ways out of where you stand.
  @prop {{ name: string }[]} targets - Everyone here you may attack right now.
  @prop {{ name: string }[]} sleepers - Everyone asleep here whose pack you may go through.
  @prop {{ name: string, word: string, health: number }[]} foes - The creatures here, which you may strike.
  @prop {null | { place_name: string, can_return: boolean }} body - Your body, if you have died and walk as a spirit.
  @prop {null | { dormant: boolean, can_seek: boolean, memories: number, needed: number }} forgotten - Your way back, if you slept too long and are a forgotten spirit.
  @fires command - A button was pressed; `detail` is the line to send to the game, such as "north" or "wait 10m".
-->
<script>
  import { emit } from '@zubra/runtime'

  const WAITS = [
    { line: 'wait 1m', text: 'Wait 1 min' },
    { line: 'wait 10m', text: 'Wait 10 min' },
    { line: 'wait 1h', text: 'Wait 1 hour' },
  ]
  const spirit = Boolean(body) || Boolean(forgotten)
  const dormant = Boolean(forgotten) && forgotten.dormant
  const canReturn = spirit && body.can_return
</script>
<style>
  :host { display: block; }
  div { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  button {
    font: inherit; padding: 0.55rem 0.8rem; min-height: 2.75rem;
    border: 1px solid var(--eq-edge, #3d3a34); border-radius: 0.5rem;
    background: var(--eq-button, #f6f2e7); color: var(--eq-ink, #24221e); cursor: pointer;
  }
  button.primary { background: var(--eq-you, #1f4e79); color: #fff; border-color: transparent; }
  button.danger { background: var(--eq-marked, #a3262a); color: #fff; border-color: transparent; }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  small { display: block; opacity: 0.8; }
</style>
<eq-actions exits={[]} can-gather={false} can-take={false} targets={[]} sleepers={[]} foes={[]} body={null} forgotten={null}>
  <div zb-if={forgotten} role="group" aria-label="Your redemption">
    <button zb-if={dormant} type="button" class="primary" onclick={() => emit('command', 'wake')}>Wake</button>
    <button zb-if={!dormant} type="button" class="primary" disabled={!forgotten.can_seek} onclick={() => emit('command', 'seek')}>
      Seek a memory
      <small>{forgotten.memories} of {forgotten.needed} found</small>
    </button>
  </div>
  <div zb-if={spirit} role="group" aria-label="Your body">
    <button type="button" class="primary" disabled={!canReturn} onclick={() => emit('command', 'return')}>
      Return to your body
      <small>{canReturn ? "it lies here" : body.place_name}</small>
    </button>
    <button type="button" class="danger" onclick={() => emit('command', 'relinquish')}>
      Give it up
      <small>be reborn</small>
    </button>
  </div>
  <div zb-if={targets.length + sleepers.length + foes.length > 0} role="group" aria-label="Others here">
    <zb-each items={foes} as="foe" key={foe.name}>
      <button type="button" class="danger" disabled={spirit} onclick={() => emit('command', `attack ${foe.word}`)}>
        Fight {foe.name}
        <small>{foe.health} health</small>
      </button>
    </zb-each>
    <zb-each items={targets} as="target" key={target.name}>
      <button type="button" class="danger" onclick={() => emit('command', `attack ${target.name}`)}>
        Attack {target.name}
      </button>
    </zb-each>
    <zb-each items={sleepers} as="sleeper" key={sleeper.name}>
      <button type="button" class="danger" onclick={() => emit('command', `rob ${sleeper.name}`)}>
        Rob {sleeper.name}
        <small>asleep</small>
      </button>
    </zb-each>
  </div>
  <div role="group" aria-label="Go">
    <zb-each items={exits} as="exit" key={exit.label}>
      <button type="button" disabled={!exit.open} onclick={() => emit('command', exit.label)}>
        Go {exit.label}
        <small>{exit.open ? exit.to_name : "under water"}</small>
      </button>
    </zb-each>
  </div>
  <div role="group" aria-label="Do">
    <button type="button" class="primary" disabled={!canGather} onclick={() => emit('command', 'gather')}>{spirit ? "Draw ectoplasm" : "Gather"}</button>
    <button zb-if={canTake} type="button" class="primary" disabled={spirit} onclick={() => emit('command', 'take')}>Take what's here</button>
    <button type="button" onclick={() => emit('command', 'inspect')}>Inspect</button>
    <button type="button" disabled={Boolean(body) || dormant} onclick={() => emit('command', 'sleep 8h')}>{forgotten ? "Lie dormant" : "Sleep 8 hours"}</button>
    <zb-each items={WAITS} as="wait" key={wait.line}>
      <button type="button" onclick={() => emit('command', wait.line)}>{wait.text}</button>
    </zb-each>
  </div>
</eq-actions>
