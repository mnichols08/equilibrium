<!--
  What you can do right now: walk out by an exit, gather, pick things up, challenge someone, or let time pass.
  A spirit can only walk, draw ectoplasm, return to its body while it still lies there, or practise where the living would work until it lives again.
  @prop {{ label: string, to: number, to_name: string, open: boolean }[]} exits - The ways out of where you stand.
  @prop {{ name: string }[]} targets - Everyone here you may attack right now.
  @prop {{ name: string }[]} sleepers - Everyone asleep here whose pack you may go through.
  @prop {{ name: string, word: string, health: number }[]} foes - The creatures here, which you may strike.
  @prop {null | { place_name: string, state: string, can_return: boolean }} body - Your body, if you have died and walk as a spirit. `state` is "lying", "risen" or "buried".
  @prop {null | { dormant: boolean, unborn: boolean, can_seek: boolean, memories: number, needed: number }} forgotten - Set if you slept too long and are a forgotten spirit, or have not lived yet.
  @prop {null | { level: number, needed: number }} afterlife - How far you have practised in the afterlife, if you are a spirit.
  @prop {boolean} canSpar - Whether you are a spirit standing where a shade can be fought for practice.
  @prop {string[]} burials - The names of the dead whose bodies lie here, which you could bury.
  @prop {boolean} canRite - Whether the ground here is stripped enough for a Restoration Rite you could take part in.
  @prop {boolean} riteWaiting - Whether someone else has begun a rite here and is waiting for a second voice.
  @prop {boolean} asleep - Whether you are lying down. If so, waking is the thing to do.
  @prop {boolean} online - Whether the game is on a server, where time passes by itself: no waiting, and sleep lasts until you wake.
  @fires command - A button was pressed; `detail` is the line to send to the game, such as "north" or "wait 10m".
-->
<script>
  import { emit } from '@zubra/runtime'

  const WAITS = [
    { line: 'wait 1m', text: 'Wait 1 min' },
    { line: 'wait 10m', text: 'Wait 10 min' },
    { line: 'wait 1h', text: 'Wait 1 hour' },
  ]
  const spirit = Boolean(body) || Boolean(forgotten)
  const dormant = Boolean(forgotten) && forgotten.dormant
  const lying = Boolean(body) && body.state === 'lying'
  const canReturn = lying && body.can_return
</script>
<style>
  :host { display: block; }
  div { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  button {
    font: inherit; padding: 0.55rem 0.8rem; min-height: 2.75rem;
    border: 1px solid var(--eq-edge, #3d3a34); border-radius: 0.5rem;
    background: var(--eq-button, #f6f2e7); color: var(--eq-ink, #24221e); cursor: pointer;
  }
  button.primary { background: var(--eq-you, #1f4e79); color: #fff; border-color: transparent; }
  button.danger { background: var(--eq-marked, #a3262a); color: #fff; border-color: transparent; }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  small { display: block; opacity: 0.8; }
</style>
<eq-actions exits={[]} can-spar={false} can-gather={false} can-take={false} targets={[]} sleepers={[]} foes={[]} burials={[]} body={null} forgotten={null} afterlife={null} asleep={false} online={false} can-rite={false} rite-waiting={false}>
  <div zb-if={spirit} role="group" aria-label="Your way back">
    <button zb-if={dormant} type="button" class="primary" onclick={() => emit('command', 'wake')}>Wake</button>
    <button zb-if={lying} type="button" class="primary" disabled={!canReturn} onclick={() => emit('command', 'return')}>
      Return to your body
      <small>{canReturn ? "it lies here" : body.place_name}</small>
    </button>
    <button zb-if={forgotten && !forgotten.unborn && !dormant} type="button" class="primary" disabled={!forgotten.can_seek} onclick={() => emit('command', 'seek')}>
      Seek a memory
      <small>{forgotten.memories} of {forgotten.needed} found</small>
    </button>
  </div>
  <div zb-if={targets.length + sleepers.length + foes.length + burials.length > 0} role="group" aria-label="Others here">
    <zb-each items={burials} as="name" key={name}>
      <button type="button" onclick={() => emit('command', `bury ${name}`)}>
        Bury {name}
        <small>they will remember</small>
      </button>
    </zb-each>
    <zb-each items={foes} as="foe" key={foe.name}>
      <button type="button" class="danger" disabled={spirit} onclick={() => emit('command', `attack ${foe.word}`)}>
        Fight {foe.name}
        <small>{foe.health} health</small>
      </button>
    </zb-each>
    <zb-each items={targets} as="target" key={target.name}>
      <button type="button" class="danger" onclick={() => emit('command', `attack ${target.name}`)}>
        Attack {target.name}
      </button>
    </zb-each>
    <zb-each items={sleepers} as="sleeper" key={sleeper.name}>
      <button type="button" class="danger" onclick={() => emit('command', `rob ${sleeper.name}`)}>
        Rob {sleeper.name}
        <small>asleep</small>
      </button>
    </zb-each>
  </div>
  <div role="group" aria-label="Go">
    <zb-each items={exits} as="exit" key={exit.label}>
      <button type="button" disabled={!exit.open} onclick={() => emit('command', exit.label)}>
        Go {exit.label}
        <small>{exit.open ? exit.to_name : "under water"}</small>
      </button>
    </zb-each>
  </div>
  <div role="group" aria-label="Do">
    <button type="button" class="primary" disabled={!canGather} onclick={() => emit('command', 'gather')}>
      {spirit ? "Practise" : "Gather"}
      <small zb-if={afterlife}>level {afterlife.level} of {afterlife.needed} to live again</small>
    </button>
    <button zb-if={canSpar} type="button" class="primary" onclick={() => emit('command', 'attack shade')}>
      Fight a shade
      <small zb-if={afterlife}>level {afterlife.level} of {afterlife.needed} to live again</small>
    </button>
    <button zb-if={canRite} type="button" class="primary" onclick={() => emit('command', 'rite')}>
      {riteWaiting ? "Answer the rite" : "Begin a rite"}
      <small>{riteWaiting ? "mends this place" : "needs a second voice"}</small>
    </button>
    <button zb-if={canTake} type="button" class="primary" disabled={spirit} onclick={() => emit('command', 'take')}>Take what's here</button>
    <button type="button" onclick={() => emit('command', 'inspect')}>Inspect</button>
    <button zb-if={asleep} type="button" class="primary" onclick={() => emit('command', 'wake')}>Wake up</button>
    <button zb-if={!asleep} type="button" disabled={Boolean(body) || dormant} onclick={() => emit('command', 'sleep 8h')}>{forgotten ? "Lie dormant" : online ? "Sleep" : "Sleep 8 hours"}</button>
    <zb-each items={online ? [] : WAITS} as="wait" key={wait.line}>
      <button type="button" onclick={() => emit('command', wait.line)}>{wait.text}</button>
    </zb-each>
  </div>
</eq-actions>
